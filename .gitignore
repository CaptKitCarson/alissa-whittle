.idea/

# source materials kept locally — large originals, OpenDesign exports,
# client-provided photos/videos, compliance PDFs. Site uses processed
# copies in public/ or src/assets/. Leading slash anchors this to the
# repo root so src/assets/ stays tracked.
/assets/

# Claude Code user-local permissions/settings — auto-created per machine.
# Skills and shared settings (.claude/skills/, .claude/settings.json) stay tracked.
.claude/settings.local.json
