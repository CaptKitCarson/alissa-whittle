---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCTA from '../components/FinalCTA.astro';
import portrait from '../assets/photos/headshot-about.jpg';

const SITE_URL = 'https://www.alissawhittle.com';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alissa Whittle',
  jobTitle: 'Financial Advisor',
  description: 'In financial planning since 2003, independent under LPL Financial as of 2026. Background in accounting, business management, and marketing.',
  worksFor: {
    '@type': 'Organization',
    name: 'LPL Financial',
    url: 'https://www.lpl.com/',
  },
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Behavioral Financial Advisor',
      credentialCategory: 'certification',
      recognizedBy: { '@type': 'Organization', name: 'Think2Perform' },
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Certified Plan Fiduciary Advisor',
      credentialCategory: 'certification',
      recognizedBy: { '@type': 'Organization', name: 'National Association of Plan Advisors' },
    },
  ],
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'FINRA CRD',
    value: '6445648',
  },
  telephone: '+1-305-928-2928',
  email: 'Alissa.Whittle@LPL.com',
  workLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '92200 Overseas Highway',
      addressLocality: 'Tavernier',
      addressRegion: 'FL',
      postalCode: '33070',
      addressCountry: 'US',
    },
  },
  url: SITE_URL + '/about/',
  mainEntityOfPage: SITE_URL + '/about/',
  award: 'Best of Florida 2025 — Financial Advisor, Tavernier',
  sameAs: [
    'https://brokercheck.finra.org/individual/summary/6445648',
    'https://guidetoflorida.com/tavernier/financial-insurance-services/alissa-whittle-cpfa-bfa-financial-advisor',
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: 'About', item: SITE_URL + '/about/' },
  ],
};

const community = [
  {
    eyebrow: 'Family & youth',
    items: [
      { name: 'Girl Scouts', detail: 'Leader since 2011' },
      { name: 'Foster parent', detail: 'Since 2012' },
      { name: 'Greenheart Exchange', detail: 'Host family + regional coordinator' },
      { name: 'Up with People', detail: 'Host family' },
      { name: 'Foreign exchange', detail: 'Host family' },
    ],
  },
  {
    eyebrow: 'Service & civic',
    items: [
      { name: 'Rotary', detail: '' },
      { name: 'Business & Professional Women', detail: 'BPW' },
      { name: 'Chi Sigma Phi', detail: '' },
      { name: 'Toastmasters', detail: '' },
      { name: 'Chamber of Commerce', detail: '' },
      { name: 'Community Foundation', detail: '' },
      { name: 'Leadership Success Academy', detail: '2024 cohort' },
    ],
  },
  {
    eyebrow: 'Local & environment',
    items: [
      { name: 'Coral Restoration Foundation', detail: 'CRF' },
      { name: 'Reef Restore USA', detail: '' },
      { name: 'Island Fest', detail: 'Volunteer' },
      { name: 'Gigantic Nautical Market', detail: 'Volunteer' },
      { name: 'Mosaic', detail: 'Sponsor' },
      { name: 'Social Olympics', detail: '' },
      { name: 'Our House program', detail: '' },
    ],
  },
  {
    eyebrow: 'Faith & advocacy',
    items: [
      { name: 'Bible study', detail: '' },
      { name: 'MMI', detail: 'Mission trip to Bolivia' },
      { name: 'iCare', detail: '' },
      { name: 'Human-trafficking rescue', detail: 'Volunteer' },
    ],
  },
  {
    eyebrow: 'Earlier chapters',
    items: [
      { name: 'Family Readiness Group', detail: 'Former head, Fort Benning' },
      { name: 'Enlisted Spouses Club', detail: 'Former head, Fort Benning' },
    ],
  },
];
---

<BaseLayout
  title="About · Alissa Whittle · Independent Fiduciary · Tavernier, FL"
  description="In financial planning since 2003, independent under LPL Financial. Girl Scouts leader since 2011, foster parent since 2012, mission work in Bolivia, reef restoration. The full story."
  ogType="profile"
  schema={[personSchema, breadcrumbSchema]}
>
  <header class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">About &nbsp;·&nbsp; the long version</span>
          <h1>Community first. <i>Investments</i> second.</h1>
          <p class="hero-sub">Alissa Whittle, BFA™, CPFA. Financial Advisor with LPL Financial. In the industry since 2003, independent as of 2026. Based in Tavernier, the Florida Keys town she chose, not just the one she works in.</p>
          <div class="hero-meta">
            <span>BFA™ · CPFA</span>
            <span class="dot" aria-hidden="true"></span>
            <span>CRD&nbsp;6445648</span>
            <span class="dot" aria-hidden="true"></span>
            <span>19 states</span>
          </div>
        </div>
        <figure class="hero-portrait portrait-figure" aria-label="Portrait of Alissa Whittle">
          <Image
            src={portrait}
            alt="Alissa Whittle, independent fiduciary financial advisor"
            widths={[400, 600, 900, 1200]}
            sizes="(min-width: 880px) 40vw, 90vw"
            quality={82}
            class="portrait-photo"
            loading="eager"
          />
          <figcaption class="portrait-caption">
            <b>Alissa Whittle</b><br />
            MountainTop Financial → LPL Financial · Tavernier
          </figcaption>
        </figure>
      </div>
    </div>
  </header>

  <section class="band fade" id="bio" aria-labelledby="bio-h">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow">I &nbsp;·&nbsp; The work</span>
        <h2 id="bio-h">A practice built around showing up.</h2>
      </header>
      <div class="bio-prose">
        <p>With a background in <strong>accounting, business management, and marketing</strong>, Alissa brings precision, professionalism, and passion to every client relationship. Originally from North Dakota, she traded the cold for the sunshine and coastal lifestyle of the Florida Keys, where she now serves clients locally and across the country while maintaining strong ties to Colorado through regular visits. As an independent financial advisor affiliated with <strong>LPL Financial</strong>, Alissa specializes in retirement planning, wealth management, and legacy strategies, helping clients navigate every stage of their financial journey: from building wealth and funding education for children and grandchildren to charitable giving, retirement income planning, and creating clear, understandable distribution strategies.</p>
        <p>Outside of her practice, Alissa is deeply committed to community involvement, leadership, and service. She has been a Girl Scout leader since 2011 and has supported numerous local and international initiatives focused on education, family support, environmental stewardship, and humanitarian outreach. Her volunteer work has included participation in a medical mission trip to Bolivia, supporting organizations assisting survivors of human trafficking, serving as a foster parent since 2012, hosting foreign exchange students, and volunteering with local community programs and events throughout the Florida Keys.</p>
        <p>Alissa is actively involved in organizations including Rotary, Business and Professional Women, the Islamorada Chamber of Commerce, Toastmasters, reef restoration with coral planting, and local charitable and leadership initiatives such as Leadership Success Academy and Community Foundation programs.</p>
        <p>When she is not working with clients or volunteering, Alissa enjoys traveling, scuba diving, pickleball, and spending time with family and friends.</p>
      </div>
    </div>
  </section>

  <div class="wrap"><div class="rule-band" aria-hidden="true"></div></div>

  <section class="band fade" id="community" aria-labelledby="community-h">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow">II &nbsp;·&nbsp; In the community</span>
        <h2 id="community-h">Where she shows up when she's not at her desk.</h2>
        <p class="lead">A working list. Some of these are decade-plus commitments. Some are one-time. All of them say something about how she chooses to spend her hours.</p>
      </header>

      <div class="community-grid">
        {community.map((group) => (
          <article class="community-group">
            <span class="eyebrow plain">{group.eyebrow}</span>
            <ul class="community-list">
              {group.items.map((item) => (
                <li>
                  <span class="ci-name">{item.name}</span>
                  {item.detail && <span class="ci-detail">{item.detail}</span>}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band fade" id="credentials" aria-labelledby="cred-h">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow">III &nbsp;·&nbsp; Credentials</span>
        <h2 id="cred-h">The boring (but important) part.</h2>
      </header>
      <div class="about-meta about-meta-grid">
        <span><b>Financial Advisor</b>LPL Financial</span>
        <span><b>BFA™</b>Behavioral Financial Advisor</span>
        <span><b>CPFA</b>Certified Plan Fiduciary Advisor</span>
        <span><b>Since 2003</b>in the industry</span>
        <span><b>Fiduciary</b>standard of care</span>
        <span><b>CRD&nbsp;6445648</b>FINRA registered</span>
        <span><b>11 states</b>securities licensed</span>
        <span><b>12 states</b>insurance licensed</span>
        <span><b>Tavernier, FL</b>Florida Keys based</span>
        <span><b>BrokerCheck</b><a href="https://brokercheck.finra.org/individual/summary/6445648" target="_blank" rel="noopener" class="tlink">Verify ↗</a></span>
        <span><b>Best of Florida 2025</b><a href="https://guidetoflorida.com/tavernier/financial-insurance-services/alissa-whittle-cpfa-bfa-financial-advisor" target="_blank" rel="noopener" class="tlink">View listing ↗</a></span>
      </div>
    </div>
  </section>

  <FinalCTA
    heading="Now that you've read the long version, <i>let's talk.</i>"
    href="/#schedule"
  />
</BaseLayout>
