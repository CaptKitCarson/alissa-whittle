---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Events · Alissa Whittle · LPL Financial"
  description="Upcoming events and community engagements."
  noindex
>
  <section class="band fade in" aria-labelledby="events-h">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow">Events</span>
        <h1 id="events-h">No upcoming events.</h1>
        <p class="lead">Workshops, Chamber mixers, and community talks land here as they're scheduled. Check back, or <a href="/contact/" class="tlink">contact Alissa directly</a>.</p>
      </header>
    </div>
  </section>

  <section class="band fade" aria-labelledby="cadence-h">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow">Cadence</span>
        <h2 id="cadence-h">Off the calendar.</h2>
        <p class="lead">Workshops typically run in the off-season, January through April. Chamber, Rotary, BPW, and community gatherings happen year-round. The <a href="/about#community" class="tlink">community list on the about page</a> is a working record of the rooms she shows up in. Reach out and we'll let you know when the next public talk lands.</p>
      </header>
    </div>
  </section>
</BaseLayout>
