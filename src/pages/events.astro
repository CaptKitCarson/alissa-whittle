---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Events · Alissa Whittle · LPL Financial"
  description="Upcoming events and community engagements."
>
  <section class="band fade in" aria-labelledby="events-h">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow">Events</span>
        <h1 id="events-h">No upcoming events.</h1>
        <p class="lead">Workshops, Chamber mixers, and community talks land here as they're scheduled. Check back, or <a href="/#schedule" class="tlink">book a conversation directly</a>.</p>
      </header>
    </div>
  </section>
</BaseLayout>
