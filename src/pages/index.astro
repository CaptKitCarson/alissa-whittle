---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroBand from '../components/IntroBand.astro';
import QualifyingSection from '../components/QualifyingSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import AboutTeaser from '../components/AboutTeaser.astro';
import MonogramMark from '../components/MonogramMark.astro';
import FinalCTA from '../components/FinalCTA.astro';

const SITE_URL = 'https://www.alissawhittle.com';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alissa Whittle',
  jobTitle: 'Financial Advisor',
  worksFor: {
    '@type': 'Organization',
    name: 'LPL Financial',
    url: 'https://www.lpl.com/',
  },
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Behavioral Financial Advisor',
      credentialCategory: 'certification',
      recognizedBy: { '@type': 'Organization', name: 'Think2Perform' },
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Certified Plan Fiduciary Advisor',
      credentialCategory: 'certification',
      recognizedBy: { '@type': 'Organization', name: 'National Association of Plan Advisors' },
    },
  ],
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'FINRA CRD',
    value: '6445648',
  },
  telephone: '+1-305-928-2928',
  email: 'Alissa.Whittle@LPL.com',
  workLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '92200 Overseas Highway',
      addressLocality: 'Tavernier',
      addressRegion: 'FL',
      postalCode: '33070',
      addressCountry: 'US',
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 25.0078,
      longitude: -80.5147,
    },
  },
  url: SITE_URL + '/',
  sameAs: ['https://brokercheck.finra.org/individual/summary/6445648'],
};

const financialServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: 'Alissa Whittle',
  description: 'Independent fiduciary financial planning under LPL Financial, based in Tavernier, Florida Keys.',
  image: SITE_URL + '/og-image.jpg',
  url: SITE_URL + '/',
  telephone: '+1-305-928-2928',
  email: 'Alissa.Whittle@LPL.com',
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '92200 Overseas Highway',
    addressLocality: 'Tavernier',
    addressRegion: 'FL',
    postalCode: '33070',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 25.0078,
    longitude: -80.5147,
  },
  areaServed: [
    'Alabama', 'California', 'Colorado', 'Florida', 'Georgia',
    'Kansas', 'Michigan', 'Minnesota', 'Missouri', 'Montana',
    'Nevada', 'New Mexico', 'New York', 'North Carolina', 'Ohio',
    'Oklahoma', 'South Dakota', 'Texas', 'Virginia',
  ].map((name) => ({ '@type': 'State', name })),
  knowsAbout: [
    'Investment management',
    'Retirement income planning',
    'Tax coordination',
    'Insurance planning',
    'Estate planning support',
    'Education funding',
  ],
  parentOrganization: {
    '@type': 'Organization',
    name: 'LPL Financial',
    url: 'https://www.lpl.com/',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Alissa Whittle',
  url: SITE_URL + '/',
  inLanguage: 'en-US',
};
---

<BaseLayout schema={[personSchema, financialServiceSchema, websiteSchema]}>
  <section class="page-thesis-band" aria-labelledby="page-thesis-h">
    <div class="wrap">
      <span class="eyebrow">Alissa Whittle &nbsp;·&nbsp; Independent fiduciary &nbsp;·&nbsp; Tavernier, FL</span>
      <h1 id="page-thesis-h" class="page-thesis">A more <i>deliberate</i> relationship with your money.</h1>
    </div>
  </section>
  <IntroBand />

  <section class="band fade fiduciary-band" aria-labelledby="fiduciary-h">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow">What "fiduciary" means</span>
        <h2 id="fiduciary-h">A higher standard of care.</h2>
      </header>
      <div class="fiduciary-prose">
        <p>As a fiduciary advisor, Alissa is held to a higher standard of care and is committed to putting her clients' best interests first by providing guidance designed to align with their goals and needs.</p>
        <p>Affluent individuals and families often seek more than investment management alone. They value personalized guidance, proactive communication, and a long-term relationship built on trust. As an independent financial advisor affiliated with LPL Financial, Alissa provides customized planning and investment strategies tailored to each client's unique goals, values, family priorities, and legacy objectives.</p>
        <p>She works closely with clients to help navigate retirement income planning, investment management, tax-efficient strategies, charitable giving, estate considerations, and multigenerational planning through an independent, relationship-driven approach designed to provide objective guidance and personalized service.</p>
        <p class="fiduciary-coda">Most of her clients are retirees, pre-retirees, business owners, professionals, and families seeking long-term planning relationships.</p>
      </div>
    </div>
  </section>

  <QualifyingSection />
  <ProcessSection />
  <AboutTeaser />
  <MonogramMark />
  <FinalCTA sectionId="schedule" />
</BaseLayout>
