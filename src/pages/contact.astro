---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCTA from '../components/FinalCTA.astro';
import portrait from '../assets/photos/headshot-contact.jpg';
---

<BaseLayout
  title="Contact · Alissa Whittle · LPL Financial · Tavernier, FL"
  description="Call, text, or email Alissa Whittle, BFA™ CPFA, Financial Advisor with LPL Financial. Office at 92200 Overseas Highway, Tavernier, Florida Keys."
>
  <header class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Contact</span>
          <h1>A short conversation is <i>the easy part.</i></h1>
          <p class="hero-sub">Call or text. Mornings work best, but reach out whenever fits. The phone is the same all day. No gatekeeper, no script.</p>
          <div class="hero-meta">
            <span>Tavernier, FL</span>
            <span class="dot" aria-hidden="true"></span>
            <span>(305) 928-2928</span>
            <span class="dot" aria-hidden="true"></span>
            <span>Alissa.Whittle@LPL.com</span>
          </div>
        </div>
        <figure class="hero-portrait portrait-figure" aria-label="Portrait of Alissa Whittle">
          <Image
            src={portrait}
            alt="Alissa Whittle, Financial Advisor with LPL Financial"
            widths={[400, 600, 900]}
            sizes="(min-width: 880px) 40vw, 90vw"
            quality={82}
            class="portrait-photo"
          />
          <figcaption class="portrait-caption">
            <b>Alissa Whittle, BFA™ CPFA</b><br />
            Financial Advisor · LPL Financial
          </figcaption>
        </figure>
      </div>
    </div>
  </header>

  <section class="band fade" id="ways-to-reach" aria-labelledby="reach-h">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow">I &nbsp;·&nbsp; Ways to reach her</span>
        <h2 id="reach-h">Three doors, all open.</h2>
      </header>

      <div class="qual-grid" style="margin-top: clamp(2rem, 4vw, 3rem);">
        <div class="qual-item">
          <span class="n">01</span>
          <p class="q"><b>Call or text</b><br /><a href="tel:+13059282928" class="tlink">(305) 928-2928</a><span class="t-muted">Same number all day. Texts are fine for scheduling.</span></p>
        </div>
        <div class="qual-item">
          <span class="n">02</span>
          <p class="q"><b>Email</b><br /><a href="mailto:Alissa.Whittle@LPL.com" class="tlink">Alissa.Whittle@LPL.com</a><span class="t-muted">For longer questions or document handoffs.</span></p>
        </div>
        <div class="qual-item">
          <span class="n">03</span>
          <p class="q"><b>Office</b><br />92200 Overseas Highway<br />Tavernier, FL 33070<span class="t-muted">MM 92 · Conference-room meetings by appointment.</span></p>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA
    heading="Or skip the back-and-forth and <i>just grab a slot.</i>"
    href="/#schedule"
    phone={false}
  />
</BaseLayout>
