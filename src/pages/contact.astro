---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCTA from '../components/FinalCTA.astro';
import portrait from '../assets/photos/headshot-contact.jpg';

const SITE_URL = 'https://www.alissawhittle.com';

// Shares the '#business' @id with the FinancialService on the homepage so Google
// merges them into one business entity rather than two competing ones.
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  '@id': SITE_URL + '/#business',
  name: 'Alissa Whittle',
  image: SITE_URL + '/og-image.jpg',
  url: SITE_URL + '/',
  telephone: '+1-305-928-2928',
  email: 'Alissa.Whittle@LPL.com',
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '92200 Overseas Highway',
    addressLocality: 'Tavernier',
    addressRegion: 'FL',
    postalCode: '33070',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 25.0078,
    longitude: -80.5147,
  },
  hasMap: 'https://www.google.com/maps/search/?api=1&query=92200%20Overseas%20Highway%2C%20Tavernier%2C%20FL%2033070',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+1-305-928-2928',
    email: 'Alissa.Whittle@LPL.com',
    contactType: 'customer service',
    areaServed: 'US',
    availableLanguage: 'English',
  },
  parentOrganization: {
    '@type': 'Organization',
    name: 'LPL Financial',
    url: 'https://www.lpl.com/',
  },
};

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': SITE_URL + '/contact/#contactpage',
  url: SITE_URL + '/contact/',
  name: 'Contact Alissa Whittle',
  description: 'Call, text, or email Alissa Whittle, Financial Advisor with LPL Financial, in Tavernier, Florida Keys.',
  mainEntity: { '@id': SITE_URL + '/#business' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: SITE_URL + '/contact/' },
  ],
};
---

<BaseLayout
  title="Contact · Alissa Whittle · LPL Financial · Tavernier, FL"
  description="Call, text, or email Alissa Whittle, BFA™ CPFA, Financial Advisor with LPL Financial. Office at 92200 Overseas Highway, Tavernier, Florida Keys."
  schema={[contactPageSchema, businessSchema, breadcrumbSchema]}
>
  <header class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Contact</span>
          <h1>A short conversation is <i>the easy part.</i></h1>
          <p class="hero-sub">Call or text. Mornings work best, but reach out whenever fits. The phone is the same all day. No gatekeeper, no script.</p>
          <div class="hero-meta">
            <span>Tavernier, FL</span>
            <span class="dot" aria-hidden="true"></span>
            <span>(305) 928-2928</span>
            <span class="dot" aria-hidden="true"></span>
            <span>Alissa.Whittle@LPL.com</span>
          </div>
        </div>
        <figure class="hero-portrait portrait-figure" aria-label="Portrait of Alissa Whittle">
          <Image
            src={portrait}
            loading="eager"
            fetchpriority="high"
            alt="Alissa Whittle, Financial Advisor with LPL Financial"
            widths={[400, 600, 900]}
            sizes="(min-width: 880px) 40vw, 90vw"
            quality={82}
            class="portrait-photo"
          />
          <figcaption class="portrait-caption">
            <b>Alissa Whittle, BFA™ CPFA</b><br />
            Financial Advisor · LPL Financial
          </figcaption>
        </figure>
      </div>
    </div>
  </header>

  <section class="band fade" id="ways-to-reach" aria-labelledby="reach-h">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow">I &nbsp;·&nbsp; Ways to reach her</span>
        <h2 id="reach-h">Three doors, all open.</h2>
      </header>

      <div class="qual-grid" style="margin-top: clamp(2rem, 4vw, 3rem);">
        <div class="qual-item">
          <span class="n">01</span>
          <p class="q"><b>Call or text</b><br /><a href="tel:+13059282928" class="tlink">(305) 928-2928</a><span class="t-muted">Same number all day. Texts are fine for scheduling.</span></p>
        </div>
        <div class="qual-item">
          <span class="n">02</span>
          <p class="q"><b>Email</b><br /><a href="mailto:Alissa.Whittle@LPL.com" class="tlink">Alissa.Whittle@LPL.com</a><span class="t-muted">For longer questions or document handoffs.</span></p>
        </div>
        <div class="qual-item">
          <span class="n">03</span>
          <p class="q"><b>Office</b><br />92200 Overseas Highway<br />Tavernier, FL 33070<span class="t-muted">MM 92 · Conference-room meetings by appointment.</span></p>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA
    heading="Call or email to <i>start a conversation.</i>"
    href="#ways-to-reach"
    phone={false}
  />
</BaseLayout>
