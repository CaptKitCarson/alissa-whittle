---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Alissa Whittle · LPL Financial · Tavernier, FL"
  description="Call, text, or email Alissa Whittle. Office at 92200 Overseas Highway, Tavernier, Florida Keys."
>
  <section class="band fade in" aria-labelledby="contact-h">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow">Contact</span>
        <h1 id="contact-h">A short conversation is the easy part.</h1>
        <p class="lead">Call or text. Mornings work best, but reach out whenever fits — the phone is the same all day.</p>
      </header>

      <div class="qual-grid" style="margin-top: 2.5rem;">
        <div class="qual-item">
          <span class="n">01</span>
          <p class="q"><b>Call or text</b><br /><a href="tel:13059282928" class="tlink">(305) 928-2928</a></p>
        </div>
        <div class="qual-item">
          <span class="n">02</span>
          <p class="q"><b>Email</b><br /><a href="mailto:Alissa.Whittle@LPL.com" class="tlink">Alissa.Whittle@LPL.com</a></p>
        </div>
        <div class="qual-item">
          <span class="n">03</span>
          <p class="q"><b>Office</b><br />92200 Overseas Highway<br />Tavernier, FL 33070</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
