---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Client Portals · Alissa Whittle · LPL Financial"
  description="Account access for existing clients: AccountView and eMoney."
>
  <section class="band fade in" aria-labelledby="portals-h">
    <div class="wrap">
      <header class="section-head">
        <span class="eyebrow">Client portals</span>
        <h1 id="portals-h">Account access for existing clients.</h1>
        <p class="lead">Both portals open in a new tab. If you need help logging in or have not yet been onboarded, call <a href="tel:13059282928" class="tlink">(305) 928-2928</a>.</p>
      </header>

      <div class="qual-grid" style="margin-top: 2.5rem;">
        <a href="https://accountview.lpl.com/web/login" target="_blank" rel="noopener" class="qual-item" style="text-decoration: none;">
          <span class="n">01</span>
          <p class="q"><b>AccountView</b><br />Statements, transactions, and account balances through LPL Financial.</p>
        </a>
        <a href="https://wealth.emaplan.com/" target="_blank" rel="noopener" class="qual-item" style="text-decoration: none;">
          <span class="n">02</span>
          <p class="q"><b>eMoney (Wealth Plan)</b><br />Your full financial picture. Accounts aggregated, plan progress, document vault.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
