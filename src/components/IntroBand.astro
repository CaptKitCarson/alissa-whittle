---
import { Image } from 'astro:assets';
import headshot from '../assets/photos/headshot-hero.jpg';
---

<section class="band intro-band fade" aria-label="About Alissa">
  <div class="wrap">
    <div class="intro-grid">
      <div class="intro-copy">
        <p class="intro-lead">
          After seventeen years in the industry, Alissa Whittle is operating independently under LPL Financial. Conversations happen at her desk in Tavernier, or on a phone call after work. No 1-800 numbers. No rotating account team.
        </p>
        <div class="intro-meta">
          <span>BFA™ · CPFA</span>
          <span class="dot" aria-hidden="true"></span>
          <span>CRD 6445648</span>
          <span class="dot" aria-hidden="true"></span>
          <span>Seventeen years</span>
        </div>
      </div>
      <figure class="intro-portrait portrait-figure" aria-label="Portrait of Alissa Whittle">
        <Image
          src={headshot}
          alt="Alissa Whittle, independent fiduciary financial advisor"
          widths={[400, 600, 900]}
          sizes="(min-width: 880px) 32vw, 75vw"
          quality={82}
          class="portrait-photo"
          loading="lazy"
        />
        <figcaption class="portrait-caption">
          <b>Alissa Whittle</b><br />
          MountainTop Financial → LPL Financial · Tavernier
        </figcaption>
      </figure>
    </div>
  </div>
</section>
