---
import { Image } from 'astro:assets';
import headshot from '../assets/photos/headshot-hero.jpg';
---

<header class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Independent fiduciary &nbsp;·&nbsp; Tavernier, Florida</span>
        <h1>A more <i>deliberate</i> relationship with your money.</h1>
        <p class="hero-sub">After seventeen years in the industry, Alissa Whittle is operating independently under LPL Financial. Conversations happen at her desk in Tavernier — or on a phone call after work. No 1-800 numbers, no rotating account team.</p>
        <div class="hero-actions">
          <a href="#schedule" class="btn btn-primary">
            Schedule a conversation
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 5l7 7-7 7"/></svg>
          </a>
          <a href="/about" class="tlink">Read about Alissa <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="hero-meta">
          <span>CRD&nbsp;6445648</span>
          <span class="dot" aria-hidden="true"></span>
          <span>Fiduciary</span>
          <span class="dot" aria-hidden="true"></span>
          <span>19 states</span>
        </div>
      </div>
      <figure class="hero-portrait portrait-figure" aria-label="Portrait of Alissa Whittle">
        <Image
          src={headshot}
          alt="Alissa Whittle, independent fiduciary financial advisor"
          widths={[400, 600, 900, 1200]}
          sizes="(min-width: 880px) 40vw, 90vw"
          quality={82}
          class="portrait-photo"
          loading="eager"
        />
        <figcaption class="portrait-caption">
          <b>Alissa Whittle</b><br />
          MountainTop Financial → LPL Financial · Tavernier
        </figcaption>
      </figure>
    </div>
  </div>
</header>
