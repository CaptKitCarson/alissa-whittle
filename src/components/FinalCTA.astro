---
interface Props {
  heading?: string;
  href?: string;
  label?: string;
  sectionId?: string;
  phone?: boolean;
}
const {
  heading = 'Twenty minutes. No pitch deck. Just a <i>conversation.</i>',
  href = '/contact/',
  label = 'Start the conversation',
  sectionId,
  phone = true,
} = Astro.props;

const isExternal = typeof href === 'string' && /^https?:\/\//i.test(href);
---

<section class="final-cta fade" id={sectionId} aria-labelledby="cta-h">
  <div class="wrap">
    <div class="fc-grid">
      <h2 id="cta-h" set:html={heading} />
      <div class="fc-aside">
        <p>Tavernier office, video, or phone. Your call.</p>
        <a
          href={href}
          class="btn btn-on-teal"
          target={isExternal ? '_blank' : undefined}
          rel={isExternal ? 'noopener noreferrer' : undefined}
        >
          {label}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 5l7 7-7 7"/></svg>
        </a>
        {phone && (
          <a href="tel:+13059282928" class="fc-direct">
            <span class="fc-direct-label">or call directly</span>
            <span class="fc-direct-num">(305) 928-2928</span>
          </a>
        )}
      </div>
    </div>
  </div>
</section>
